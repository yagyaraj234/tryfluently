DATABASE_URL=postgres://impromptu:impromptu@localhost:5433/impromptu
METRICS_ENABLED=true
BETTER_AUTH_SECRET=change-me
# The browser reaches the API through the web app's /api pass-through, so auth lives on the web origin.
BETTER_AUTH_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3001
# Where the web server forwards /api/* (the default)
API_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# provider:model for each AI job
MODEL_STEP=openai:gpt-5-mini
MODEL_BRIEF=openai:gpt-5
MODEL_ROADMAP=openai:gpt-5
MODEL_JUDGE=openai:gpt-5
MODEL_REPORT=openai:gpt-5
# OpenAI Realtime model ID (no provider prefix); defaults to gpt-realtime
MODEL_REALTIME=gpt-realtime-mini
# Live voice calls: openai (default) or rime (Rime Prism, needs RIME_API_KEY). See docs/adr/0005.
REALTIME_PROVIDER=openai
RIME_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=Fluently <coach@tryfluently.site>
KENPATH_BASE_URL=
KENPATH_API_KEY=
KENPATH_MODEL=
KENPATH_VOICE=
# Optional billing: leave all four credentials/product IDs blank to keep checkout disabled.
# Configure separate test/live products as described in docs/billing.md. Never expose these to the web bundle.
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PRO_PRODUCT_ID=
DODO_PACK_PRODUCT_ID=
